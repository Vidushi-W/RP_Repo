# Server only. No API key or paid service is used.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_THREAD=4
OLLAMA_TIMEOUT_SECONDS=120
# Local multilingual speech model is downloaded explicitly with scripts/setup_speech.py.
# STT_MODEL_PATH may be an absolute model directory inside this component.
