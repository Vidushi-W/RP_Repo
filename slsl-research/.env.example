# Copy to backend/.env and adjust paths for your machine

# SQLite database (relative to backend/)
SLSL_DATABASE_URL=sqlite:///./slsl_studio.db

# Filesystem paths (relative to backend/ or absolute)
SLSL_DATA_DIR=../data
SLSL_ARTIFACTS_DIR=../artifacts

# Frontend dev server origins
SLSL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit in bytes (default 50 MB)
# SLSL_MAX_UPLOAD_BYTES=52428800
