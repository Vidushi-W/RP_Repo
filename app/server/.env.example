# Server only. Never put these credentials in the Flutter app.
MONGODB_URI=
MONGODB_DATABASE=slsl_connect
# Empty Mongo URI uses a separate SQLite DEVELOPMENT database.
# Set APP_ENV=production to require MongoDB (no silent fallback).
APP_ENV=development
# Relative to server/; admin assets are consumed read-only.
ADMIN_PROJECT_DIR=../../slsl-research
# Optional exported model bundle; empty follows admin's current active model.
MODEL_BUNDLE_DIR=

# Allow CPU models to finish while an Android emulator is running.
LOCAL_AI_TIMEOUT_SECONDS=240
